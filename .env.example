# =============================================================================
# CLOUDINARY CONFIGURATION
# =============================================================================

# Cloudinary cloud name from your Cloudinary Dashboard.
# Used to upload, store, transform, and deliver images and videos.
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key used to authenticate Cloudinary API requests.
CLOUDINARY_API_KEY=

# Cloudinary API secret used to sign and authorize Cloudinary operations.
# Keep this secret and never commit actual values to Git.
CLOUDINARY_API_SECRET=


# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# Secret key used to generate and verify JWT tokens for authentication.
# Use a long random string in production.
JWT_SECRET=


# =============================================================================
# EMAIL (BREVO / SENDINBLUE SMTP)
# =============================================================================

# SMTP server hostname.
SMTP_SERVER=smtp-relay.brevo.com

# SMTP port.
# 587 = TLS (recommended)
# 465 = SSL
SMTP_PORT=587

# SMTP username generated by Brevo.
SMTP_USERNAME=

# SMTP password/API key generated by Brevo.
# Never expose this value publicly.
SMTP_PASSWORD=

# Sender email address used when sending emails.
SMTP_FROM_EMAIL=


# =============================================================================
# TWILIO WHATSAPP
# =============================================================================

# Twilio Account SID from the Twilio Console.
TWILIO_ACCOUNT_SID=

# Twilio Auth Token used to authenticate Twilio API requests.
# Keep this secret.
TWILIO_AUTH_TOKEN=

# WhatsApp-enabled Twilio sender number.
# Example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=


# =============================================================================
# GOOGLE GEMINI
# =============================================================================

# Gemini API key from Google AI Studio.
# Used for multimodal AI tasks such as celebrity recognition,
# image understanding, and AI assistant features.
GEMINI_API_KEY=


# =============================================================================
# HUGGING FACE
# =============================================================================

# Hugging Face access token.
# Recommended permission: Read-only.
# Used to download models from Hugging Face Hub with higher rate limits.
HF_TOKEN=